<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>swt2.kids_app</groupId>
        <artifactId>kidsapp</artifactId>
        <version>0.1-SNAPSHOT</version>
    </parent>

    <artifactId>database</artifactId>
    <packaging>pom</packaging>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <!-- Alle laufenden Container stoppen -->
                    <execution>
                        <id>docker-compose-down</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <workingDirectory>${project.basedir}/..</workingDirectory>
                            <executable>docker-compose</executable>
                            <arguments>
                                <argument>--profile</argument>
                                <argument>db</argument>
                                <argument>down</argument>
                                <argument>-v</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>remove-db-volume</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <workingDirectory>${project.basedir}/..</workingDirectory>
                            <executable>docker</executable>
                            <arguments>
                                <argument>volume</argument>
                                <argument>rm</argument>
                                <argument>-f</argument>
                                <argument>swt2_kids_app_mariadb_data</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- Datenbank starten -->
                    <execution>
                        <id>docker-compose-up-mariadb</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <workingDirectory>${project.basedir}/..</workingDirectory>
                            <executable>docker-compose</executable>
                            <arguments>
                                <argument>--profile</argument>
                                <argument>db</argument>
                                <argument>up</argument>
                                <argument>--build</argument>
                                <argument>-d</argument>
                                <argument>mariadb</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
